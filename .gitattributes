# Normalize line endings to LF for all text files.
# This prevents CRLF vs LF conflicts between Windows (Antigravity) and WSL (Orchestrator).
* text=auto eol=lf

# Source code — always LF
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf
*.sh    text eol=lf

# PowerShell scripts — keep CRLF (Windows native)
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.wasm  binary

# Immutable original research inputs: preserve the exact downloaded/extracted
# bytes used by their pinned SHA-256 contracts. Some upstream files contain
# CRLF or intentionally mixed line endings and must not be rewritten by Git.
data/historical/global-equity-research-chain/originals/oecd-share-prices-monthly.csv binary
